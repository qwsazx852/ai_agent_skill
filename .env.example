# 台灣股市每日篩選系統 - 環境變數範本
# 複製此檔案為 .env 並填入實際值

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. 在 Telegram 搜尋 @BotFather
# 2. 傳送 /newbot 建立 Bot
# 3. 取得 Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 1. 搜尋 @userinfobot
# 2. 傳送任意訊息
# 3. 複製 Id 數字
TELEGRAM_CHAT_ID=your_chat_id_here

# ── FinMind API ───────────────────────────────────────────────────────────────
# 1. 前往 https://finmindtrade.com/ 註冊
# 2. 登入後至個人頁面取得 Token
# 不設定時將使用模擬資料（僅供測試）
FINMIND_API_TOKEN=your_finmind_token_here

# ── Streamlit Dashboard URL ───────────────────────────────────────────────────
# 部署到 Streamlit Cloud 後的網址
# 格式: https://your-app-name.streamlit.app
STREAMLIT_DASHBOARD_URL=https://your-app.streamlit.app
